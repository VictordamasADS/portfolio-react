    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "VITE_TEST=true vitest --watch=false",
    "test:coverage": "vitest run --coverage",
    "test:cypress": "yarn start-server-and-test 'yarn dev' 3007 'cypress run'",
    "test:solidarity": "npx solidarity",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config ./vitest.config.e2e.ts",
    "test:all": "yarn test && yarn test:e2e && yarn test:cypress",
    "cypress:open": "cypress open",
    "cypress:report": "yarn node cypress/reporter.js",
    "husky:prepare": "npx husky install && npx husky add .husky/commit-msg \"npx --no -- commitlint  --edit $1\" && npx husky add .husky/pre-commit \"yarn test\""
